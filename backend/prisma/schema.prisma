generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  password       String
  nama           String
  isFirstLogin   Boolean  @default(true)
  createdAt      DateTime @default(now())
  
  preferences    AccessibilityPreference?
  categoryPrefs  UserCategoryPreference[]
  
  @@map("users")
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  nama      String
  createdAt DateTime @default(now())
  
  articles  Article[]
  
  @@map("admins")
}

model Category {
  id   Int    @id @default(autoincrement())
  nama String
  slug String @unique
  
  articles      Article[]
  userPrefs     UserCategoryPreference[]
  
  @@map("categories")
}

model Article {
  id           Int        @id @default(autoincrement())
  judul        String
  slug         String     @unique
  isi          String
  thumbnailUrl String?
  publisherName String?   @map("publisher_name")
  status       String     @default("draft")
  publishedAt  DateTime?  @map("published_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  adminId      Int        @map("admin_id")
  admin        Admin      @relation(fields: [adminId], references: [id])
  categoryId   Int        @map("category_id")
  category     Category   @relation(fields: [categoryId], references: [id])

  @@map("articles")
}

model AccessibilityPreference {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  ukuranTeks      String   @default("medium")
  modeKontras     String   @default("dark")
  modeButaWarna   String   @default("none")
  jarakBaris      String   @default("normal")
  kecepatanTts    Float    @default(1.0)
  volumeTts       Float    @default(1.0)
  updatedAt       DateTime @updatedAt
  
  // onDelete: Cascade — baris preferensi tidak punya arti tanpa usernya, jadi
  // ikut terhapus saat user dihapus. Tanpa ini Prisma memakai RESTRICT (default
  // untuk relasi wajib), yang membuat user TIDAK BISA dihapus sama sekali
  // selama baris ini ada — dan baris ini dibuat otomatis oleh getPreferences(),
  // jadi setiap user yang pernah login pasti punya satu.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("accessibility_preferences")
}

model UserCategoryPreference {
  id         Int      @id @default(autoincrement())
  userId     Int
  categoryId Int
  createdAt  DateTime @default(now())
  
  // Sama seperti di atas: pilihan kategori milik user ikut terhapus bersamanya.
  // Relasi ke Category sengaja DIBIARKAN restrict — menghapus satu kategori
  // memang seharusnya gagal dan memberi peringatan, bukan diam-diam membuang
  // pilihan kategori milik user.
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  
  @@unique([userId, categoryId])
  @@map("user_category_preferences")
}